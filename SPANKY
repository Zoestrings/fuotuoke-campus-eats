      <div class="pipeline-step">
        <div class="num">02</div>
        <h3>Scan the Tag</h3>
        <p>Use your phone camera on the physical item's authenticated label.</p>
      </div>
      <div class="pipeline-step">
        <div class="num">03</div>
        <h3>Buy Merch, Mint for Free</h3>
        <p>Connect your Phantom/Solflare wallet to claim your digital collectible without mint fees.</p>
      </div>
    </div>
  </div>
</section>

<section id="access">
  <div class="wrap">
    <div class="section-eyebrow">Token-Gated Community Ecosystem</div>
    <div class="section-head">
      <h2>Verified Access Only</h2>
    </div>
    <div class="access-grid">
      <div class="access-card">
