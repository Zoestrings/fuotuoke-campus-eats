<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Bank of Spanky</title>
<style>
  :root{
    --ivory:#faf9f6;
    --paper:#ffffff;
    --ink:#1a1a1a;
    --ink-soft:#4a4a4a;
    --line:#dcd8cf;
    --warm-grey:#8c8577;
    --spanky-pink:#e8a0b4;
    --spanky-pink-deep:#c97a90;
  }

  *{box-sizing:border-box;margin:0;padding:0;}

  body{
    background:var(--ivory);
    color:var(--ink);
    font-family:'Georgia','Times New Roman',serif;
    line-height:1.55;
  }

  a{color:inherit;text-decoration:none;}
  .wrap{max-width:1180px;margin:0 auto;padding:0 40px;}
  img{display:block; max-width:100%; height:auto;}

  /* ---------- NAV ---------- */
  header{
    position:sticky; top:0; z-index:50;
    background:rgba(250,249,246,0.96);
    border-bottom:1px solid var(--line);
  }
  nav{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 40px;
    max-width:1180px; margin:0 auto;
  }
  .brand{
    display:flex; align-items:center; gap:12px;
    font-size:1.2rem;
    letter-spacing:0.1em;
    font-weight:400;
  }
  .brand img{
    height:38px; width:auto;
  }
  .navlinks{
    display:none;
    gap:34px;
    font-size:0.78rem;
    letter-spacing:0.08em;
    color:var(--ink);
  }
  @media(min-width:900px){.navlinks{display:flex;}}
  .navlinks a{
    padding-bottom:4px;
    border-bottom:1px solid transparent;
    transition:border-color 0.2s ease;
  }
  .navlinks a:hover{border-color:var(--spanky-pink-deep);}
  .navicons{
    display:flex; gap:20px; font-size:0.78rem; letter-spacing:0.05em; color:var(--ink-soft);
  }

  /* thin pink rule under header, nod to the brand's own palette */
  .pink-rule{
    height:2px;
    background:linear-gradient(90deg, transparent, var(--spanky-pink), transparent);
  }

  /* ---------- HERO ---------- */
  .hero{
    padding:80px 0 100px;
    border-bottom:1px solid var(--line);
  }
  .hero-grid{
    display:grid; grid-template-columns:1fr; gap:56px; align-items:center;
  }
  @media(min-width:900px){
    .hero-grid{grid-template-columns:1fr 1fr;}
  }
  .hero-tag{
    font-size:0.72rem;
    letter-spacing:0.18em;
    color:var(--spanky-pink-deep);
    margin-bottom:22px;
  }
  .hero h1{
    font-size:clamp(2.2rem, 5vw, 3.6rem);
    font-weight:400;
    letter-spacing:0.01em;
    line-height:1.1;
    margin-bottom:26px;
  }
  .hero .sub{
    color:var(--ink-soft);
    font-size:1.02rem;
    line-height:1.75;
    max-width:44ch;
    margin-bottom:38px;
  }
  .cta-row{
    display:flex; gap:18px; flex-wrap:wrap;
  }
  .btn{
    padding:15px 30px;
    font-family:inherit;
    font-size:0.76rem;
    letter-spacing:0.1em;
    cursor:pointer;
    border-radius:0;
  }
  .btn-primary{
    background:var(--ink); color:var(--paper); border:1px solid var(--ink);
    transition:background 0.2s ease, color 0.2s ease;
  }
  .btn-primary:hover{background:var(--spanky-pink-deep); border-color:var(--spanky-pink-deep);}
  .btn-secondary{
    background:transparent; color:var(--ink); border:1px solid var(--ink);
    transition:background 0.2s ease, color 0.2s ease;
  }
  .btn-secondary:hover{background:var(--ink); color:var(--paper);}

  .hero-media{
    position:relative;
    aspect-ratio:4/5;
    background:var(--paper);
    border:1px solid var(--line);
    overflow:hidden;
  }
  .hero-media img{
    width:100%; height:100%; object-fit:cover;
  }
  .rarity-badge{
    position:absolute; top:18px; left:18px;
    background:var(--paper);
    border:1px solid var(--ink);
    font-size:0.68rem; letter-spacing:0.06em;
    padding:6px 12px;
    z-index:2;
  }
  .rarity-badge.two{top:auto; bottom:18px; left:auto; right:18px;}

  /* video banner strip, from the brand's own SPANK-BANG asset */
  .video-strip{
    border-bottom:1px solid var(--line);
    background:var(--paper);
  }
  .video-strip video{
    width:100%; display:block; max-height:520px; object-fit:cover;
  }

  /* ---------- SECTION SHELL ---------- */
  section{
    padding:100px 0;
    border-bottom:1px solid var(--line);
  }
  .section-eyebrow{
    font-size:0.72rem; letter-spacing:0.16em; color:var(--spanky-pink-deep);
    margin-bottom:18px;
  }
  .section-head{
    max-width:680px;
    margin-bottom:60px;
  }
  .section-head h2{
    font-size:clamp(1.8rem,3.4vw,2.4rem);
    font-weight:400;
    margin-bottom:20px;
  }
  .section-head p{
    color:var(--ink-soft);
    font-size:0.98rem;
    line-height:1.75;
    max-width:60ch;
  }

  /* ---------- ORIGINAL SITE CATEGORY TILES (kept, restyled) ---------- */
  .cat-grid{
    display:grid; grid-template-columns:1fr;
    border-top:1px solid var(--line);
  }
  @media(min-width:760px){
    .cat-grid{grid-template-columns:repeat(4,1fr);}
  }
  .cat-card{
    border-bottom:1px solid var(--line);
    padding:0 0 36px;
  }
  @media(min-width:760px){
    .cat-card{border-right:1px solid var(--line); padding:0 28px 36px;}
    .cat-card:last-child{border-right:none;}
  }
  .cat-card img{
    width:100%; aspect-ratio:1/1; object-fit:cover;
    margin-bottom:22px;
    border-bottom:1px solid var(--line);
  }
  .cat-card h3{
    font-size:1rem; font-weight:400; letter-spacing:0.03em; margin-bottom:10px;
    padding:0 28px;
  }
  @media(min-width:760px){.cat-card h3{padding:0;}}
  .cat-card p{
    color:var(--ink-soft); font-size:0.88rem; margin-bottom:18px;
    padding:0 28px;
  }
  @media(min-width:760px){.cat-card p{padding:0;}}
  .text-link{
    font-size:0.74rem; letter-spacing:0.1em;
    border-bottom:1px solid var(--spanky-pink-deep);
    padding:0 28px 3px;
  }
  @media(min-width:760px){.text-link{padding:0 0 3px;}}

  /* ---------- MERCH PIPELINE ---------- */
  .pipeline{
    display:grid; grid-template-columns:1fr;
    border-top:1px solid var(--line);
  }
  @media(min-width:760px){
    .pipeline{grid-template-columns:repeat(3,1fr);}
  }
  .pipeline-step{
    padding:40px 36px 40px 0;
    border-bottom:1px solid var(--line);
  }
  @media(min-width:760px){
    .pipeline-step{border-right:1px solid var(--line); padding:40px 36px;}
    .pipeline-step:last-child{border-right:none;}
  }
  .pipeline-step .num{
    font-size:0.75rem; letter-spacing:0.1em; color:var(--spanky-pink-deep);
    margin-bottom:16px;
  }
  .pipeline-step h3{
    font-size:1.05rem; font-weight:400; margin-bottom:12px;
  }
  .pipeline-step p{
    color:var(--ink-soft); font-size:0.9rem; line-height:1.7;
  }

  /* ---------- ACCESS GRID ---------- */
  .access-grid{
    display:grid; grid-template-columns:1fr;
    border-top:1px solid var(--line);
  }
  @media(min-width:760px){
    .access-grid{grid-template-columns:repeat(3,1fr);}
  }
  .access-card{
    padding:40px 36px 40px 0;
    border-bottom:1px solid var(--line);
  }
  @media(min-width:760px){
    .access-card{border-right:1px solid var(--line); padding:40px 36px;}
    .access-card:last-child{border-right:none;}
  }
  .access-card h3{
    font-size:1.02rem; font-weight:400; margin-bottom:14px;
  }
  .access-card p{
    color:var(--ink-soft); font-size:0.9rem; line-height:1.75;
  }

  /* ---------- BLUEPRINT / ALLOCATION ---------- */
  .alloc-row{
    display:grid; grid-template-columns:1fr;
    gap:8px 40px;
    padding:32px 0;
    border-top:1px solid var(--line);
    align-items:baseline;
  }
  .alloc-row.last{border-bottom:1px solid var(--line);}
  @media(min-width:700px){
    .alloc-row{grid-template-columns:260px 1fr;}
  }
  .alloc-row h3{
    font-size:1.02rem; font-weight:400;
  }
  .alloc-row p{
    color:var(--ink-soft); font-size:0.92rem; line-height:1.75;
  }

  .disclosure{
    margin-top:32px;
    padding:20px 24px;
    border:1px solid var(--line);
    border-left:3px solid var(--spanky-pink);
    font-size:0.82rem;
    color:var(--ink-soft);
    max-width:680px;
    line-height:1.7;
  }

  /* ---------- ORIGINAL SITE: WHO IS SPANKY ---------- */
  .story{
    text-align:center;
  }
  .story .section-eyebrow{text-align:center;}
  .story h2{
    font-size:clamp(1.7rem,3.4vw,2.3rem); font-weight:400; margin:0 auto 22px; max-width:20ch;
  }
  .story p{
    max-width:56ch; margin:0 auto 28px; color:var(--ink-soft); font-size:0.98rem; line-height:1.75;
  }

  /* ---------- ORIGINAL SITE: NEWSLETTER ---------- */
  .newsletter{
    text-align:center;
    background:linear-gradient(180deg, var(--ivory), #fdf3f6);
  }
  .newsletter h2{
    font-size:clamp(1.5rem,3vw,2rem); font-weight:400; margin-bottom:14px;
  }
  .newsletter p{color:var(--ink-soft); margin-bottom:34px;}
  .newsletter-form{
    display:flex; justify-content:center;
    max-width:440px; margin:0 auto;
    border:1px solid var(--ink);
  }
  .newsletter-form input{
    flex:1; padding:15px 18px; border:none; background:transparent;
    font-family:inherit; font-size:0.9rem; color:var(--ink);
  }
  .newsletter-form input:focus{outline:none;}
  .newsletter-form button{
    padding:15px 26px; background:var(--ink); color:var(--paper);
    border:none; font-family:inherit; font-size:0.76rem; letter-spacing:0.1em; cursor:pointer;
  }
  .newsletter-form button:hover{background:var(--spanky-pink-deep);}

  /* ---------- FOOTER ---------- */
  footer{
    padding:56px 0 36px;
    text-align:center;
  }
  .footer-links{
    display:flex; flex-wrap:wrap; justify-content:center; gap:28px;
    font-size:0.76rem; letter-spacing:0.06em; color:var(--ink-soft);
    margin-bottom:28px;
  }
  .footer-links a:hover{color:var(--spanky-pink-deep);}
  footer .brand{justify-content:center; margin-bottom:18px;}
  footer p.notice{
    font-size:0.72rem; color:var(--warm-grey);
    max-width:60ch; margin:0 auto;
    line-height:1.7;
  }
</style>
</head>
<body>

<header>
  <nav>
    <div class="navlinks">
