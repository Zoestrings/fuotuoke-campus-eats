    <div class="cat-grid">
      <div class="cat-card">
        <img src="https://mediumturquoise-grasshopper-556994.hostingersite.com/wp-content/uploads/2026/08/tab02.png" alt="OG Merch">
        <h3>OG Merch</h3>
        <p>Drip hard. Stay Spanky. Merch for the real degens.</p>
        <a class="text-link" href="#">Shop Now</a>
      </div>
      <div class="cat-card">
        <img src="https://mediumturquoise-grasshopper-556994.hostingersite.com/wp-content/uploads/2026/08/tab01.png" alt="OG Collection">
